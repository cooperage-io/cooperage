{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cooperage: SSE gateway (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "cooperage.cli.main",
            "args": ["start", "--sse"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "LOG_LEVEL": "DEBUG"
            },
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Cooperage: pytest (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-s", "-v"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Cooperage: pytest (all)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["--ignore=tests/test_cloud_integration.py", "-s", "-v"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}
